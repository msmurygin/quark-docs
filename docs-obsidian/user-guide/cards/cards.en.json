 {
  "id": "Z1",
  "title": "RF keys and common messages",
  "area": "reference",
  "layout": "reference",
  "needs": [],
  "sections": [
   {
    "kind": "keys",
    "title": "Keys",
    "rows": [
     {
      "keys": [
       "Esc"
      ],
      "text": "Back one screen. Some screens ask first."
     },
     {
      "keys": [
       "F1"
      ],
      "text": "Main Menu (if the screen does not use it)"
     },
     {
      "keys": [
       "F2-F8"
      ],
      "text": "The job named in the footer. Grey = not now."
     },
     {
      "keys": [
       "Enter"
      ],
      "text": "Next field. On the last field it sends."
     },
     {
      "keys": [
       "Down"
      ],
      "text": "Next field. It never sends."
     },
     {
      "keys": [
       "Up"
      ],
      "text": "Previous field"
     },
     {
      "keys": [
       "Left",
       "Right"
      ],
      "text": "Change a choice field (UOM, Condition)"
     },
     {
      "keys": [
       "Space",
       "Y",
       "N"
      ],
      "text": "Yes or no field. Y = yes, N = no."
     },
     {
      "keys": [
       "F2"
      ],
      "text": "On a field with a list: opens the list"
     },
     {
      "keys": [
       "1-8"
      ],
      "text": "Menu: open the item with that number"
     },
     {
      "keys": [
       "9",
       "0"
      ],
      "text": "Menu: next page (9), previous page (0)"
     },
     {
      "keys": [
       "Y",
       "N"
      ],
      "text": "Answer a question. [Esc] cancels it."
     },
     {
      "keys": [
       "Up",
       "Down",
       "Enter"
      ],
      "text": "List: move, choose a row"
     },
     {
      "keys": [
       "Ctrl+C"
      ],
      "text": "Closes the RF session"
     }
    ]
   },
   {
    "kind": "messages",
    "title": "Common messages",
    "rows": [
     {
      "msg": "No permission: …",
      "do": "You may not do this. Tell your supervisor."
     },
     {
      "msg": "Supervisor Override / Confirmation",
      "do": "Hand over the terminal. Supervisor types name, password, [Enter]."
     },
     {
      "msg": "Cancelled",
      "do": "You said no to a question. Nothing was done."
     },
     {
      "msg": "Session expired. Please sign in again.",
      "do": "Sign in again (card L1)."
     },
     {
      "msg": "… modified concurrently, please retry",
      "do": "Someone changed it too. Press [Enter] again."
     },
     {
      "msg": "… is locked, please retry",
      "do": "Wait a moment. Send again."
     },
     {
      "msg": "Red status line, no reply",
