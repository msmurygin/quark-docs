 {
  "id": "R6",
  "title": "Capture serial numbers",
  "area": "receiving",
  "needs": [
   "the units, each with a serial label"
  ],
  "steps": [
   {
    "text": "**Serial Capture** opens after the line",
    "keys": [],
    "note": "Serial-tracked SKUs only"
   },
   {
    "text": "Scan one serial in **Serial #**",
    "keys": []
   },
   {
    "text": "Scan the next unit. Repeat for all",
    "keys": [],
    "note": "**Progress** shows 1 из 5. из means of."
   },
   {
    "text": "Last serial: **Serial Capture Complete**",
    "keys": [],
    "note": "You return to **Scan SKU** by yourself."
   },
   {
    "text": "Must stop? Press [Esc], then [Y]",
    "keys": [
     "Esc",
     "Y",
     "N"
    ],
    "note": "To keep scanning press [N]"
   },
   {
    "text": "Later: Receiving menu, press [7]",
    "keys": [
     "7"
    ]
   },
   {
    "text": "Choose your row, press [Enter]",
    "keys": [
     "Enter"
    ],
    "note": "Row: receipt / SKU / captured/expected"
